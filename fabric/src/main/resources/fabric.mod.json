{
  "schemaVersion": 1,
  "id": "hexconstruct",
  "version": "${version}",
  "name": "HexConstruct",
  "description": "A Hex Casting addon.",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://github.com/xm1221/HexConstruct",
    "sources": "https://github.com/xm1221/HexConstruct"
  },
  "license": "MIT",
  "icon": "assets/hexconstruct/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexConstruct.fabric.FabricHexConstruct"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexConstruct.fabric.FabricHexConstructClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexConstruct.fabric.FabricHexConstructServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexConstruct.fabric.datagen.FabricHexConstructDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.HexConstruct.fabric.FabricHexConstructModMenu"
    }]
  },
  "mixins": [
    "hexconstruct-common.mixins.json",
    "hexconstruct-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
